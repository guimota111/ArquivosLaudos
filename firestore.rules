rules_version = '2';

// Acesso RESTRITO: somente usuários autenticados (login por e-mail/senha)
// podem ler e escrever na coleção `nodes`.
// Habilite o provedor "E-mail/senha" em Authentication no console do Firebase
// e crie os usuários que terão acesso.
service cloud.firestore {
  match /databases/{database}/documents {
    match /nodes/{nodeId} {
      allow read, write: if request.auth != null;
    }
    // Favoritas: cada usuário só acessa o próprio documento.
    match /favorites/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
